# ─── Supabase (existing Passo project) ──────────────────────────────────────
# Browser-visible. Safe to expose: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used by scripts/seed.ts and the scope-prospects
# agent. Never commit a real value, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic links come back to. No trailing slash.
#   local: http://localhost:3000
#   prod:  https://prospects.passoagency.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Optional research keys (the agent degrades gracefully without these) ───
# Companies House public API. Free: register at
# https://developer.company-information.service.gov.uk/
# Absent means the agent falls back to the public website and records the
# lower-confidence source in the payload.
COMPANIES_HOUSE_API_KEY=
